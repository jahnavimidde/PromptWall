# PromptWall - Environment Configuration Example
# Copy this file to .env for local configuration.
# NEVER commit .env to version control or paste real credentials into this file.

# -----------------------------------------------------------------------------
# Upstream LLM Provider Credentials (Optional fallbacks if client doesn't provide auth header)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-EXAMPLE_PLACEHOLDER_NOT_A_REAL_KEY_00000000000000000000
GEMINI_API_KEY=AIzaSy_EXAMPLE_PLACEHOLDER_NOT_A_REAL_KEY_0000000
ANTHROPIC_API_KEY=sk-ant-api03-EXAMPLE_PLACEHOLDER_NOT_A_REAL_KEY_0000000000000000

# -----------------------------------------------------------------------------
# Gateway Server Settings
# -----------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Python PII Detector Service
# -----------------------------------------------------------------------------
DETECTOR_URL=http://localhost:5002
DETECTOR_TIMEOUT=30

# -----------------------------------------------------------------------------
# Enterprise Authentication & Security (M12)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-secure-random-32-byte-hex-string-for-production
PROMETHEUS_AUTH_TOKEN=change-me-prometheus-bearer-token

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DATABASE_URL=file:./data/pasteguard.db
